# Ignore heavy archives and executables
*.zip
*.exe
*.rar
*.7z
*.tar.gz

# Ignore literal mod files (Packwiz uses .pw.toml instead of jars)
*.jar

# Ignore IDE and OS specific files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ignore local logs and debug
*.log
logs/
debug/
crash-reports/

# Player data and server cache
world/
world_*/
usernamecache.json
usercache.json
banned-players.json
banned-ips.json
ops.json
whitelist.json
eula.txt

# Secrets
UsData.json
*.env
.env*
secrets/

# AI Internal & orchestration backups
uncommitted_backup/
private/
internal/
directives/

# Specific ignores for this project
lucky_world_invasion_2.0/
hardcore_project/pack/*.zip
client_main/
